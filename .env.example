# PostgreSQL connection string used by SQLAlchemy to reach the database.
DATABASE_URL=postgresql://user:password@localhost:5432/bugdle

# Secret used to sign JWTs (access/refresh tokens and the anonymous attempt token).
JWT_SECRET=replace-with-a-long-random-string

# Exact origin of the frontend; CORS is locked to this value (no wildcard).
FRONTEND_ORIGIN=http://localhost:5173
